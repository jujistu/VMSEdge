NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vms_dev?replicaSet=rs0
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=vms
JWT_AUDIENCE=vms-web
JWT_KEY_ID=v1
ACCESS_TOKEN_TTL=600
SESSION_TTL=604800
REFRESH_TOKEN_TTL=86400
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
OUTBOX_ENCRYPTION_KEY=replace-with-different-64-hex-characters
ORGANIZATION_TIMEZONE=Africa/Lagos
TRUST_PROXY=0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=vms@localhost
RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password
READINESS_TOKEN=replace-with-random-secret-for-production
LOG_LEVEL=info

# Email-only background automation. Requires the worker and SMTP.
EMAIL_AUTOMATION_ENABLED=true
VISIT_REMINDER_MINUTES=60
APPROVAL_REMINDER_MINUTES=5
APPROVAL_ESCALATION_MINUTES=15
REPORT_EMAILS_ENABLED=true
# Daily delivery hour in Africa/Lagos (0-23); reports cover the previous day.
REPORT_EMAIL_HOUR=8
